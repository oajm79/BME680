[Unit]
Description=BME680 Air Quality Monitor
Documentation=https://github.com/yourusername/BME680
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oajm
Group=oajm
WorkingDirectory=/home/oajm/projects/BME680
Environment="PATH=/home/oajm/projects/BME680/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/oajm/projects/BME680/src"
ExecStart=/home/oajm/projects/BME680/venv/bin/python3 /home/oajm/projects/BME680/sensor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening (optional)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
